SITE_NAME=Стихия
APP_SECRET_KEY=change-me-local-secret

DATABASE_URL=postgresql+asyncpg://stihia:stihia@postgres:5432/stihia
REDIS_URL=redis://redis:6379/0

BOT_SERVER_URL=http://bot-server:8080
BOT_SERVER_TOKEN=change-me-bot-token
TELEGRAM_QUEUE_RETRY_SECONDS=15

# false keeps Docker builds light. Set true when you are ready to install qwen-asr/faster-whisper in the backend image.
INSTALL_ASR_RUNTIME=false

# local_whisper | qwen_asr | browser | silero_vad_only
SPEECH_RECOGNIZER=local_whisper

TEXT_MAIN_MODEL_PATH=models/text-main.gguf
TEXT_FAST_MODEL_PATH=models/text-fast.gguf
TEXT_EMBED_MODEL_PATH=models/text-embed.gguf
VOICE_LIVE_MODEL_PATH=models/voice-live.bin
VOICE_FINAL_MODEL_PATH=models/voice-final.bin
VOICE_VAD_MODEL_PATH=models/voice-vad.onnx
QWEN_ASR_MODEL_PATH=/models/qwen-asr

STUDIO_DEFAULT_BACKGROUND=#050505
STUDIO_DEFAULT_TEXT=#f7f7f4
STUDIO_DEFAULT_FONT_SIZE=22
